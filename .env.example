# Copy this file to .env. Never commit real credentials.
LKE_HOST=127.0.0.1
LKE_PORT=8000
LKE_CHAT_BASE_URL=http://127.0.0.1:1234/v1
LKE_CHAT_MODEL=replace-with-the-model-id-shown-by-your-local-server
LKE_CHAT_API_KEY=lm-studio
LKE_CHAT_TIMEOUT_SECONDS=60
LKE_CHAT_MAX_RETRIES=1
# Enable native JSON Schema only when the local OpenAI-compatible server supports it.
LKE_GENERATION_NATIVE_STRUCTURED_OUTPUT=false
LKE_GENERATION_MAX_REPAIR_ATTEMPTS=1
LKE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LKE_EMBEDDING_MODEL_REVISION=main
LKE_EMBEDDING_DIMENSION=384
LKE_EMBEDDING_NORMALIZE=true
LKE_EMBEDDING_DOCUMENT_PREFIX=
LKE_EMBEDDING_QUERY_PREFIX="Represent this sentence for searching relevant passages: "
LKE_EMBEDDING_BATCH_SIZE=32
LKE_MULTIMODAL_MODEL=sentence-transformers/clip-ViT-B-32
LKE_MULTIMODAL_MODEL_REVISION=main
LKE_MULTIMODAL_DIMENSION=512
LKE_MAX_IMAGE_PIXELS=40000000
LKE_DEFAULT_TOP_K=3
LKE_DATABASE_URL=postgresql+psycopg://localhost/local_lke
LKE_UPLOAD_DIRECTORY=data/uploads
LKE_MAX_UPLOAD_BYTES=10485760
LKE_MAX_BATCH_BYTES=52428800
LKE_DEFAULT_PARSER_STRATEGY=fast
LKE_DEFAULT_CHUNK_STRATEGY=markdown
LKE_CHUNK_SIZE=800
LKE_CHUNK_OVERLAP=120
LKE_RETRIEVAL_CANDIDATE_LIMIT=20
LKE_RETRIEVAL_CONTEXT_TOKENS=1800
LKE_RETRIEVAL_SOURCE_TOKENS=900
LKE_RETRIEVAL_MAX_SUBQUERIES=4
LKE_RETRIEVAL_RRF_K=60
LKE_RETRIEVAL_ANSWERABILITY_THRESHOLD=0.34
LKE_RERANKER_ENABLED=false
LKE_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
LKE_STRUCTURED_MAX_ROWS=100
LKE_STRUCTURED_MAX_CSV_ROWS=50000
LKE_STRUCTURED_MAX_COLUMNS=100
LKE_STRUCTURED_STATEMENT_TIMEOUT_MS=3000
# Chapter 7 secure API mode is opt-in. Use distinct random tokens of at least
# 16 characters, keep this JSON out of source control, and restart to rotate it.
LKE_AUTH_ENABLED=false
LKE_AUTH_CREDENTIALS_JSON=[]
