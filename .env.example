# Copy this file to .env. Never commit real credentials.
LKE_HOST=127.0.0.1
LKE_PORT=8000
LKE_CHAT_BASE_URL=http://127.0.0.1:1234/v1
LKE_CHAT_MODEL=replace-with-the-model-id-shown-by-your-local-server
LKE_CHAT_API_KEY=lm-studio
LKE_CHAT_TIMEOUT_SECONDS=60
LKE_CHAT_MAX_RETRIES=1
LKE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LKE_DEFAULT_TOP_K=3

